{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.audiopod/audiopod",
  "title": "AudioPod AI",
  "description": "Audio AI tools: text-to-speech, voice cloning, music generation, stem separation, transcription.",
  "version": "2026.9.19",
  "websiteUrl": "https://docs.audiopod.ai/sdks/mcp",
  "repository": {
    "url": "https://github.com/AudiopodAI/audiopod-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.audiopod.ai",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "AudioPod API key (ap_...) from https://www.audiopod.ai/dashboard/account/api-keys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
